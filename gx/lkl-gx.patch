index cd4431ff2..7d55f2a14 100644
--- a/arch/lkl/kernel/syscalls.c
+++ b/arch/lkl/kernel/syscalls.c
@@ -10,6 +10,8 @@
 #include <linux/syscalls.h>
 #include <linux/kthread.h>
 #include <linux/platform_device.h>
